APP_NAME=Trading Intelligence API
APP_ENV=local
DEFAULT_TICKER=TSM
DATA_DIR=data
MODEL_DIR=models
DATABASE_URL=postgresql+psycopg://trading:trading@postgres:5432/trading
REDIS_URL=redis://redis:6379/0
API_KEY=
JWT_SECRET=change-me
SUPABASE_URL=
SUPABASE_ANON_KEY=
CRON_SECRET=
ALERT_MIN_CONFIDENCE=75
ALERT_SIGNALS=COMPRAR,VENDER,ESPERAR MEJOR ENTRADA
INTRADAY_ALERT_THRESHOLD_PCT=10
INTRADAY_SESSION_BARS=78
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO_PHONE=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123*
# Opcional para varios usuarios del dashboard: usuario1:clave1,usuario2:clave2
# Si se configura, reemplaza ADMIN_USERNAME/ADMIN_PASSWORD para el login.
DASHBOARD_USERS=admin:Admin123*,cliente2:CambiaEstaClave*
DASHBOARD_SESSION_COOKIE=myactions_session
